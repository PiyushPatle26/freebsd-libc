LIBFREEBSD_EXIT_HDRS-y += $(LIBFREEBSD)/src/internal/atomic.h
LIBFREEBSD_EXIT_HDRS-y += $(LIBFREEBSD)/src/internal/fork_impl.h
LIBFREEBSD_EXIT_HDRS-y += $(LIBFREEBSD)/src/internal/ksigaction.h
LIBFREEBSD_EXIT_HDRS-y += $(LIBFREEBSD)/src/internal/libc.h
LIBFREEBSD_EXIT_HDRS-y += $(LIBFREEBSD)/src/internal/lock.h
LIBFREEBSD_EXIT_HDRS-y += $(LIBFREEBSD)/src/internal/pthread_impl.h
LIBFREEBSD_EXIT_HDRS-y += $(LIBFREEBSD)/include/signal.h
LIBFREEBSD_EXIT_HDRS-y += $(LIBFREEBSD)/include/stdint.h
LIBFREEBSD_EXIT_HDRS-y += $(LIBFREEBSD)/include/stdio.h
LIBFREEBSD_EXIT_HDRS-y += $(LIBFREEBSD)/include/stdlib.h
LIBFREEBSD_EXIT_HDRS-y += $(LIBFREEBSD)/include/syscall.h


LIBFREEBSD_EXIT_SRCS-y += $(LIBFREEBSD_SRC)/lib/libc/stdlib/abort.c
LIBFREEBSD_EXIT_SRCS-y += $(LIBFREEBSD_SRC)/lib/libc/gen/assert.c
LIBFREEBSD_EXIT_SRCS-y += $(LIBFREEBSD_SRC)/lib/libc/stdlib/atexit.c
LIBFREEBSD_EXIT_SRCS-y += $(LIBFREEBSD_SRC)/lib/libc/stdlib/exit.c
LIBFREEBSD_EXIT_SRCS-y += $(LIBFREEBSD_SRC)/lib/libc/stdlib/_Exit.c
LIBFREEBSD_EXIT_SRCS-y += $(LIBFREEBSD_SRC)/lib/libc/stdlib/quick_exit.c

$(eval $(call _libfreebsd_import_lib,exit,$(LIBFREEBSD_EXIT_HDRS-y),$(LIBFREEBSD_EXIT_SRCS-y)))
