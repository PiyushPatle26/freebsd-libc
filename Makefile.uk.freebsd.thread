ifeq (x86_32,$(CONFIG_UK_ARCH))
LIBFREEBSD_THREAD_SRCS-y += $(LIBFREEBSD)/src/thread/i386/syscall_cp.s|i386
LIBFREEBSD_THREAD_SRCS-y += $(LIBFREEBSD)/src/thread/i386/tls.s|i386
else ifeq (x86_64,$(CONFIG_UK_ARCH))
LIBFREEBSD_THREAD_SRCS-y += $(LIBFREEBSD)/src/thread/x86_64/syscall_cp.s|x86_64
else ifeq (arm,$(CONFIG_UK_ARCH))
LIBFREEBSD_THREAD_SRCS-y += $(LIBFREEBSD)/src/thread/arm/__aeabi_read_tp.s|arm
LIBFREEBSD_THREAD_SRCS-y += $(LIBFREEBSD)/src/thread/arm/__aeabi_read_tp_c.c|arm
LIBFREEBSD_THREAD_SRCS-y += $(LIBFREEBSD)/src/thread/arm/atomics.s|arm
LIBFREEBSD_THREAD_SRCS-y += $(LIBFREEBSD)/src/thread/arm/syscall_cp.s|arm
else ifeq (arm64,$(CONFIG_UK_ARCH))
LIBFREEBSD_THREAD_SRCS-y += $(LIBFREEBSD)/src/thread/aarch64/__unmapself.s|aarch64
LIBFREEBSD_THREAD_SRCS-y += $(LIBFREEBSD)/src/thread/aarch64/syscall_cp.s|aarch64
else
LIBFREEBSD_THREAD_SRCS-y += $(LIBFREEBSD)/src/thread/clone.c|thread
endif


$(eval $(call _libfreebsd_import_lib,thread,$(LIBFREEBSD_THREAD_HDRS-y),$(LIBFREEBSD_THREAD_SRCS-y)))
