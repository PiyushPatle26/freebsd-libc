LIBFREEBSD_LINUX_HDRS-y += $(LIBFREEBSD)/include/errno.h
LIBFREEBSD_LINUX_HDRS-y += $(LIBFREEBSD)/include/fcntl.h
LIBFREEBSD_LINUX_HDRS-y += $(LIBFREEBSD)/src/internal/libc.h
LIBFREEBSD_LINUX_HDRS-y += $(LIBFREEBSD)/include/poll.h
LIBFREEBSD_LINUX_HDRS-y += $(LIBFREEBSD)/src/internal/pthread_impl.h
LIBFREEBSD_LINUX_HDRS-y += $(LIBFREEBSD)/include/sched.h
LIBFREEBSD_LINUX_HDRS-y += $(LIBFREEBSD)/include/signal.h
LIBFREEBSD_LINUX_HDRS-y += $(LIBFREEBSD)/include/stdarg.h
LIBFREEBSD_LINUX_HDRS-y += $(LIBFREEBSD)/include/stdint.h
LIBFREEBSD_LINUX_HDRS-y += $(LIBFREEBSD)/src/internal/syscall.h
LIBFREEBSD_LINUX_HDRS-y += $(LIBFREEBSD)/include/sys/epoll.h
LIBFREEBSD_LINUX_HDRS-y += $(LIBFREEBSD)/include/sys/eventfd.h
LIBFREEBSD_LINUX_HDRS-y += $(LIBFREEBSD)/include/sys/fanotify.h
LIBFREEBSD_LINUX_HDRS-y += $(LIBFREEBSD)/include/sys/file.h
LIBFREEBSD_LINUX_HDRS-y += $(LIBFREEBSD)/include/sys/fsuid.h
LIBFREEBSD_LINUX_HDRS-y += $(LIBFREEBSD)/include/sys/inotify.h
LIBFREEBSD_LINUX_HDRS-y += $(LIBFREEBSD)/include/sys/io.h
LIBFREEBSD_LINUX_HDRS-y += $(LIBFREEBSD)/include/sys/klog.h
LIBFREEBSD_LINUX_HDRS-y += $(LIBFREEBSD)/include/sys/mman.h
LIBFREEBSD_LINUX_HDRS-y += $(LIBFREEBSD)/include/sys/mount.h
LIBFREEBSD_LINUX_HDRS-y += $(LIBFREEBSD)/include/sys/personality.h
LIBFREEBSD_LINUX_HDRS-y += $(LIBFREEBSD)/include/sys/prctl.h
LIBFREEBSD_LINUX_HDRS-y += $(LIBFREEBSD)/include/sys/ptrace.h
LIBFREEBSD_LINUX_HDRS-y += $(LIBFREEBSD)/include/sys/quota.h
LIBFREEBSD_LINUX_HDRS-$(CONFIG_LIBUKRANDOM) += $(LIBFREEBSD)/include/sys/random.h
LIBFREEBSD_LINUX_HDRS-y += $(LIBFREEBSD)/include/sys/reboot.h
LIBFREEBSD_LINUX_HDRS-y += $(LIBFREEBSD)/include/sys/resource.h
LIBFREEBSD_LINUX_HDRS-y += $(LIBFREEBSD)/include/sys/sendfile.h
LIBFREEBSD_LINUX_HDRS-y += $(LIBFREEBSD)/include/sys/signalfd.h
LIBFREEBSD_LINUX_HDRS-y += $(LIBFREEBSD)/include/sys/swap.h
LIBFREEBSD_LINUX_HDRS-y += $(LIBFREEBSD)/include/sys/sysinfo.h
LIBFREEBSD_LINUX_HDRS-y += $(LIBFREEBSD)/include/sys/time.h
LIBFREEBSD_LINUX_HDRS-y += $(LIBFREEBSD)/include/sys/timerfd.h
LIBFREEBSD_LINUX_HDRS-y += $(LIBFREEBSD)/include/sys/timex.h
LIBFREEBSD_LINUX_HDRS-y += $(LIBFREEBSD)/include/sys/uio.h
LIBFREEBSD_LINUX_HDRS-y += $(LIBFREEBSD)/include/sys/wait.h
LIBFREEBSD_LINUX_HDRS-y += $(LIBFREEBSD)/include/sys/xattr.h
LIBFREEBSD_LINUX_HDRS-y += $(LIBFREEBSD)/include/time.h
LIBFREEBSD_LINUX_HDRS-y += $(LIBFREEBSD)/include/unistd.h

# No linux-specific sources in FreeBSD libc
LIBFREEBSD_LINUX_SRCS-y :=

$(eval $(call _libfreebsd_import_lib,linux,$(LIBFREEBSD_LINUX_HDRS-y),$(LIBFREEBSD_LINUX_SRCS-y)))
