LIBFREEBSD_TEMP_HDRS-y += $(LIBFREEBSD)/include/errno.h
LIBFREEBSD_TEMP_HDRS-y += $(LIBFREEBSD)/include/fcntl.h
LIBFREEBSD_TEMP_HDRS-y += $(LIBFREEBSD)/src/internal/libc.h
LIBFREEBSD_TEMP_HDRS-y += $(LIBFREEBSD)/include/stdint.h
LIBFREEBSD_TEMP_HDRS-y += $(LIBFREEBSD)/include/stdlib.h
LIBFREEBSD_TEMP_HDRS-y += $(LIBFREEBSD)/include/string.h
LIBFREEBSD_TEMP_HDRS-y += $(LIBFREEBSD)/include/sys/stat.h
LIBFREEBSD_TEMP_HDRS-y += $(LIBFREEBSD)/include/time.h
LIBFREEBSD_TEMP_HDRS-y += $(LIBFREEBSD)/include/unistd.h

LIBFREEBSD_TEMP_SRCS-y += $(LIBFREEBSD)/src/temp/__randname.c
LIBFREEBSD_TEMP_SRCS-y += $(LIBFREEBSD)/src/temp/mkdtemp.c
LIBFREEBSD_TEMP_SRCS-y += $(LIBFREEBSD)/src/temp/mkostemp.c
LIBFREEBSD_TEMP_SRCS-y += $(LIBFREEBSD)/src/temp/mkostemps.c
LIBFREEBSD_TEMP_SRCS-y += $(LIBFREEBSD)/src/temp/mkstemp.c
LIBFREEBSD_TEMP_SRCS-y += $(LIBFREEBSD)/src/temp/mkstemps.c
LIBFREEBSD_TEMP_SRCS-y += $(LIBFREEBSD)/src/temp/mktemp.c

$(eval $(call _libfreebsd_import_lib,temp,$(LIBFREEBSD_TEMP_HDRS-y),$(LIBFREEBSD_TEMP_SRCS-y)))
