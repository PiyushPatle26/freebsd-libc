LIBFREEBSD_SCHED_HDRS-y += $(LIBFREEBSD)/include/sys/membarrier.h
LIBFREEBSD_SCHED_HDRS-y += $(LIBFREEBSD)/src/internal/syscall.h

LIBFREEBSD_SCHED_SRCS-y += $(LIBFREEBSD)/src/sched/affinity.c
