LIBFREEBSD_MMAN_SRCS-y += $(LIBFREEBSD_SRC)/lib/libc/sys/msync.c
LIBFREEBSD_MMAN_SRCS-y += $(LIBFREEBSD_SRC)/lib/libc/sys/shm_open.c

$(eval $(call _libfreebsd_import_lib,mman,$(LIBFREEBSD_MMAN_HDRS-y),$(LIBFREEBSD_MMAN_SRCS-y)))
