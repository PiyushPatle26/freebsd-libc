LIBFREEBSD_MMAN_HDRS-y += $(LIBFREEBSD)/include/errno.h
LIBFREEBSD_MMAN_HDRS-y += $(LIBFREEBSD)/include/fcntl.h
LIBFREEBSD_MMAN_HDRS-y += $(LIBFREEBSD)/src/internal/libc.h
LIBFREEBSD_MMAN_HDRS-y += $(LIBFREEBSD)/include/limits.h
LIBFREEBSD_MMAN_HDRS-y += $(LIBFREEBSD)/include/pthread.h
LIBFREEBSD_MMAN_HDRS-y += $(LIBFREEBSD)/include/stdarg.h
LIBFREEBSD_MMAN_HDRS-y += $(LIBFREEBSD)/include/stdint.h
LIBFREEBSD_MMAN_HDRS-y += $(LIBFREEBSD)/include/string.h
LIBFREEBSD_MMAN_HDRS-y += $(LIBFREEBSD)/src/internal/syscall.h
LIBFREEBSD_MMAN_HDRS-y += $(LIBFREEBSD)/include/sys/syscall.h
LIBFREEBSD_MMAN_HDRS-y += $(LIBFREEBSD)/include/sys/mman.h
LIBFREEBSD_MMAN_HDRS-y += $(LIBFREEBSD)/include/unistd.h


