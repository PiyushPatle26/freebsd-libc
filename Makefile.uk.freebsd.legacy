LIBFREEBSD_LEGACY_HDRS-y += $(LIBFREEBSD)/include/utmpx.h

LIBFREEBSD_LEGACY_SRCS-y += $(LIBFREEBSD_SRC)/lib/libc/gen/err.c
LIBFREEBSD_LEGACY_SRCS-y += $(LIBFREEBSD_SRC)/lib/libc/gen/ftw.c
LIBFREEBSD_LEGACY_SRCS-y += $(LIBFREEBSD_SRC)/lib/libc/gen/getloadavg.c
