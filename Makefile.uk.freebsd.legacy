LIBFREEBSD_LEGACY_HDRS-y += $(LIBFREEBSD)/include/limits.h
LIBFREEBSD_LEGACY_HDRS-y += $(LIBFREEBSD)/include/pwd.h
LIBFREEBSD_LEGACY_HDRS-y += $(LIBFREEBSD)/include/stdarg.h
LIBFREEBSD_LEGACY_HDRS-y += $(LIBFREEBSD)/include/stddef.h
LIBFREEBSD_LEGACY_HDRS-y += $(LIBFREEBSD)/include/stdio.h
LIBFREEBSD_LEGACY_HDRS-y += $(LIBFREEBSD)/include/stdlib.h
