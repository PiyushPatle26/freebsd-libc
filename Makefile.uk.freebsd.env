LIBFREEBSD_ENV_HDRS-y += $(LIBFREEBSD)/src/internal/atomic.h
LIBFREEBSD_ENV_HDRS-y += $(LIBFREEBSD)/include/elf.h
LIBFREEBSD_ENV_HDRS-y += $(LIBFREEBSD)/include/errno.h
LIBFREEBSD_ENV_HDRS-y += $(LIBFREEBSD)/include/fcntl.h
LIBFREEBSD_ENV_HDRS-y += $(LIBFREEBSD)/src/internal/libc.h
LIBFREEBSD_ENV_HDRS-y += $(LIBFREEBSD)/include/limits.h
LIBFREEBSD_ENV_HDRS-y += $(LIBFREEBSD)/include/poll.h
LIBFREEBSD_ENV_HDRS-y += $(LIBFREEBSD)/src/internal/pthread_impl.h
LIBFREEBSD_ENV_HDRS-y += $(LIBFREEBSD)/include/signal.h
LIBFREEBSD_ENV_HDRS-y += $(LIBFREEBSD)/include/stddef.h
LIBFREEBSD_ENV_HDRS-y += $(LIBFREEBSD)/include/stdint.h
LIBFREEBSD_ENV_HDRS-y += $(LIBFREEBSD)/include/stdlib.h
LIBFREEBSD_ENV_HDRS-y += $(LIBFREEBSD)/src/include/string.h
LIBFREEBSD_ENV_HDRS-y += $(LIBFREEBSD)/include/syscall.h
LIBFREEBSD_ENV_HDRS-y += $(LIBFREEBSD)/include/sys/mman.h
