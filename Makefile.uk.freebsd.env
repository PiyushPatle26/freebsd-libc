LIBFREEBSD_ENV_SRCS-y += $(LIBFREEBSD_SRC)/lib/libc/gen/tls.c
LIBFREEBSD_ENV_SRCS-y += $(LIBFREEBSD_SRC)/lib/libc/secure/stack_protector.c

$(eval $(call _libfreebsd_import_lib,env,$(LIBFREEBSD_ENV_HDRS-y),$(LIBFREEBSD_ENV_SRCS-y)))
