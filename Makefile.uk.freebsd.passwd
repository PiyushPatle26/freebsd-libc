LIBFREEBSD_PASSWD_HDRS-y += $(LIBFREEBSD)/include/byteswap.h
LIBFREEBSD_PASSWD_HDRS-y += $(LIBFREEBSD)/include/ctype.h
LIBFREEBSD_PASSWD_HDRS-y += $(LIBFREEBSD)/include/errno.h
LIBFREEBSD_PASSWD_HDRS-y += $(LIBFREEBSD)/include/fcntl.h
LIBFREEBSD_PASSWD_HDRS-y += $(LIBFREEBSD)/include/grp.h
LIBFREEBSD_PASSWD_HDRS-y += $(LIBFREEBSD)/include/limits.h
LIBFREEBSD_PASSWD_HDRS-y += $(LIBFREEBSD)/src/passwd/nscd.h
LIBFREEBSD_PASSWD_HDRS-y += $(LIBFREEBSD)/include/pthread.h
LIBFREEBSD_PASSWD_HDRS-y += $(LIBFREEBSD)/include/pwd.h
LIBFREEBSD_PASSWD_HDRS-y += $(LIBFREEBSD)/src/passwd/pwf.h
LIBFREEBSD_PASSWD_HDRS-y += $(LIBFREEBSD)/include/shadow.h
LIBFREEBSD_PASSWD_HDRS-y += $(LIBFREEBSD)/include/stdio.h
LIBFREEBSD_PASSWD_HDRS-y += $(LIBFREEBSD)/include/stdlib.h
LIBFREEBSD_PASSWD_HDRS-y += $(LIBFREEBSD)/include/string.h
LIBFREEBSD_PASSWD_HDRS-y += $(LIBFREEBSD)/include/sys/socket.h
LIBFREEBSD_PASSWD_HDRS-y += $(LIBFREEBSD)/include/sys/stat.h
LIBFREEBSD_PASSWD_HDRS-y += $(LIBFREEBSD)/include/unistd.h


ifneq ($(CONFIG_LIBPOSIX_USER),y)
LIBFREEBSD_PASSWD_SRCS-y += $(LIBFREEBSD)/src/passwd/fgetgrent.c
LIBFREEBSD_PASSWD_SRCS-y += $(LIBFREEBSD)/src/passwd/fgetpwent.c
LIBFREEBSD_PASSWD_SRCS-y += $(LIBFREEBSD)/src/passwd/fgetspent.c

LIBFREEBSD_PASSWD_SRCS-y += $(LIBFREEBSD)/src/passwd/getgr_a.c
LIBFREEBSD_PASSWD_SRCS-y += $(LIBFREEBSD)/src/passwd/getgr_r.c

LIBFREEBSD_PASSWD_SRCS-y += $(LIBFREEBSD)/src/passwd/getgrent.c
LIBFREEBSD_PASSWD_SRCS-y += $(LIBFREEBSD)/src/passwd/getgrent_a.c
LIBFREEBSD_PASSWD_SRCS-y += $(LIBFREEBSD)/src/passwd/getpw_a.c
LIBFREEBSD_PASSWD_SRCS-y += $(LIBFREEBSD)/src/passwd/getpw_r.c
LIBFREEBSD_PASSWD_SRCS-y += $(LIBFREEBSD)/src/passwd/getpwent.c
LIBFREEBSD_PASSWD_SRCS-y += $(LIBFREEBSD)/src/passwd/getpwent_a.c
LIBFREEBSD_PASSWD_SRCS-y += $(LIBFREEBSD)/src/passwd/getgrouplist.c
endif
LIBFREEBSD_PASSWD_SRCS-y += $(LIBFREEBSD)/src/passwd/getspent.c
LIBFREEBSD_PASSWD_SRCS-y += $(LIBFREEBSD)/src/passwd/getspnam.c
LIBFREEBSD_PASSWD_SRCS-y += $(LIBFREEBSD)/src/passwd/getspnam_r.c
LIBFREEBSD_PASSWD_SRCS-y += $(LIBFREEBSD)/src/passwd/lckpwdf.c
LIBFREEBSD_PASSWD_SRCS-y += $(LIBFREEBSD)/src/passwd/nscd_query.c
LIBFREEBSD_PASSWD_SRCS-y += $(LIBFREEBSD)/src/passwd/putgrent.c
LIBFREEBSD_PASSWD_SRCS-y += $(LIBFREEBSD)/src/passwd/putpwent.c
LIBFREEBSD_PASSWD_SRCS-y += $(LIBFREEBSD)/src/passwd/putspent.c

$(eval $(call _libfreebsd_import_lib,passwd,$(LIBFREEBSD_PASSWD_HDRS-y),$(LIBFREEBSD_PASSWD_SRCS-y)))
