LIBFREEBSD_SETJMP_SRCS-y += $(LIBFREEBSD)/src/setjmp/setjmp.c
LIBFREEBSD_SETJMP_SRCS-y += $(LIBFREEBSD)/src/setjmp/longjmp.c

ifeq (arm,$(CONFIG_UK_ARCH))
LIBFREEBSD_SETJMP_SRCS-y += $(LIBFREEBSD)/src/setjmp/arm/longjmp.s|arm
LIBFREEBSD_SETJMP_SRCS-y += $(LIBFREEBSD)/src/setjmp/arm/setjmp.s|arm
else ifeq (arm64,$(CONFIG_UK_ARCH))
LIBFREEBSD_SETJMP_SRCS-y += $(LIBFREEBSD)/src/setjmp/aarch64/longjmp.s|aarch64
LIBFREEBSD_SETJMP_SRCS-y += $(LIBFREEBSD)/src/setjmp/aarch64/setjmp.s|aarch64
else ifeq (x86_32,$(CONFIG_UK_ARCH))
LIBFREEBSD_SETJMP_SRCS-y += $(LIBFREEBSD)/src/setjmp/i386/longjmp.s|i386
LIBFREEBSD_SETJMP_SRCS-y += $(LIBFREEBSD)/src/setjmp/i386/setjmp.s|i386
else ifeq (x86_64,$(CONFIG_UK_ARCH))
LIBFREEBSD_SETJMP_SRCS-y += $(LIBFREEBSD)/src/setjmp/x86_64/longjmp.s|x86_64
LIBFREEBSD_SETJMP_SRCS-y += $(LIBFREEBSD)/src/setjmp/x86_64/setjmp.s|x86_64
endif


$(eval $(call _libfreebsd_import_lib,setjmp,$(LIBFREEBSD_SETJMP_HDRS-y),$(LIBFREEBSD_SETJMP_SRCS-y)))
