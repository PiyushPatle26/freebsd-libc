LIBFREEBSD_SELECT_HDRS-y += $(LIBFREEBSD)/include/errno.h
LIBFREEBSD_SELECT_HDRS-y += $(LIBFREEBSD)/src/internal/libc.h
LIBFREEBSD_SELECT_HDRS-y += $(LIBFREEBSD)/include/poll.h
LIBFREEBSD_SELECT_HDRS-y += $(LIBFREEBSD)/include/signal.h
LIBFREEBSD_SELECT_HDRS-y += $(LIBFREEBSD)/include/stdint.h
LIBFREEBSD_SELECT_HDRS-y += $(LIBFREEBSD)/src/internal/syscall.h
LIBFREEBSD_SELECT_HDRS-y += $(LIBFREEBSD)/include/sys/select.h
LIBFREEBSD_SELECT_HDRS-y += $(LIBFREEBSD)/include/time.h

LIBFREEBSD_SELECT_SRCS-y += $(LIBFREEBSD)/src/select/poll.c
LIBFREEBSD_SELECT_SRCS-y += $(LIBFREEBSD)/src/select/pselect.c
LIBFREEBSD_SELECT_SRCS-y += $(LIBFREEBSD)/src/select/select.c

$(eval $(call _libfreebsd_import_lib,select,$(LIBFREEBSD_SELECT_HDRS-y),$(LIBFREEBSD_SELECT_SRCS-y)))
