LIBFREEBSD_IPC_HDRS-y += $(LIBFREEBSD)/include/errno.h
LIBFREEBSD_IPC_HDRS-y += $(LIBFREEBSD)/src/ipc/ipc.h
LIBFREEBSD_IPC_HDRS-y += $(LIBFREEBSD)/src/internal/libc.h
LIBFREEBSD_IPC_HDRS-y += $(LIBFREEBSD)/include/limits.h
LIBFREEBSD_IPC_HDRS-y += $(LIBFREEBSD)/include/stdarg.h
LIBFREEBSD_IPC_HDRS-y += $(LIBFREEBSD)/include/stdint.h
LIBFREEBSD_IPC_HDRS-y += $(LIBFREEBSD)/src/internal/syscall.h
LIBFREEBSD_IPC_HDRS-y += $(LIBFREEBSD)/include/sys/ipc.h
LIBFREEBSD_IPC_HDRS-y += $(LIBFREEBSD)/include/sys/msg.h
LIBFREEBSD_IPC_HDRS-y += $(LIBFREEBSD)/include/sys/sem.h
LIBFREEBSD_IPC_HDRS-y += $(LIBFREEBSD)/include/sys/shm.h
LIBFREEBSD_IPC_HDRS-y += $(LIBFREEBSD)/include/sys/stat.h

LIBFREEBSD_IPC_SRCS-y += $(LIBFREEBSD_SRC)/lib/libc/gen/ftok.c
LIBFREEBSD_IPC_SRCS-y += $(LIBFREEBSD_SRC)/lib/libc/gen/semctl.c

$(eval $(call _libfreebsd_import_lib,ipc,$(LIBFREEBSD_IPC_HDRS-y),$(LIBFREEBSD_IPC_SRCS-y)))
