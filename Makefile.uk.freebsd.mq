LIBFREEBSD_MQ_HDRS-y += $(LIBFREEBSD)/include/errno.h
LIBFREEBSD_MQ_HDRS-y += $(LIBFREEBSD)/include/fcntl.h
LIBFREEBSD_MQ_HDRS-y += $(LIBFREEBSD)/include/mqueue.h
LIBFREEBSD_MQ_HDRS-y += $(LIBFREEBSD)/include/pthread.h
LIBFREEBSD_MQ_HDRS-y += $(LIBFREEBSD)/include/signal.h
LIBFREEBSD_MQ_HDRS-y += $(LIBFREEBSD)/include/stdarg.h
LIBFREEBSD_MQ_HDRS-y += $(LIBFREEBSD)/src/internal/syscall.h
LIBFREEBSD_MQ_HDRS-y += $(LIBFREEBSD)/include/sys/socket.h
LIBFREEBSD_MQ_HDRS-y += $(LIBFREEBSD)/include/unistd.h

# No mq sources found in lib/libc
LIBFREEBSD_MQ_SRCS-y :=

$(eval $(call _libfreebsd_import_lib,mq,$(LIBFREEBSD_MQ_HDRS-y),$(LIBFREEBSD_MQ_SRCS-y)))
