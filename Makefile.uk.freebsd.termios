LIBFREEBSD_TERMIOS_HDRS-y += $(LIBFREEBSD)/include/errno.h
LIBFREEBSD_TERMIOS_HDRS-y += $(LIBFREEBSD)/src/internal/libc.h
LIBFREEBSD_TERMIOS_HDRS-y += $(LIBFREEBSD)/src/internal/syscall.h
LIBFREEBSD_TERMIOS_HDRS-y += $(LIBFREEBSD)/include/sys/ioctl.h
LIBFREEBSD_TERMIOS_HDRS-y += $(LIBFREEBSD)/include/termios.h

LIBFREEBSD_TERMIOS_SRCS-y += $(LIBFREEBSD)/src/termios/cfgetospeed.c
LIBFREEBSD_TERMIOS_SRCS-y += $(LIBFREEBSD)/src/termios/cfmakeraw.c
LIBFREEBSD_TERMIOS_SRCS-y += $(LIBFREEBSD)/src/termios/cfsetospeed.c
LIBFREEBSD_TERMIOS_SRCS-y += $(LIBFREEBSD)/src/termios/tcdrain.c
LIBFREEBSD_TERMIOS_SRCS-y += $(LIBFREEBSD)/src/termios/tcflow.c
LIBFREEBSD_TERMIOS_SRCS-y += $(LIBFREEBSD)/src/termios/tcflush.c
LIBFREEBSD_TERMIOS_SRCS-y += $(LIBFREEBSD)/src/termios/tcgetattr.c
LIBFREEBSD_TERMIOS_SRCS-y += $(LIBFREEBSD)/src/termios/tcgetsid.c
LIBFREEBSD_TERMIOS_SRCS-y += $(LIBFREEBSD)/src/termios/tcsendbreak.c
LIBFREEBSD_TERMIOS_SRCS-y += $(LIBFREEBSD)/src/termios/tcsetattr.c

$(eval $(call _libfreebsd_import_lib,termios,$(LIBFREEBSD_TERMIOS_HDRS-y),$(LIBFREEBSD_TERMIOS_SRCS-y)))
