LIBFREEBSD_STAT_HDRS-y += $(LIBFREEBSD)/include/errno.h
LIBFREEBSD_STAT_HDRS-y += $(LIBFREEBSD)/include/fcntl.h
LIBFREEBSD_STAT_HDRS-y += $(LIBFREEBSD)/src/internal/libc.h
LIBFREEBSD_STAT_HDRS-y += $(LIBFREEBSD)/src/internal/syscall.h
LIBFREEBSD_STAT_HDRS-y += $(LIBFREEBSD)/include/sys/statfs.h
LIBFREEBSD_STAT_HDRS-y += $(LIBFREEBSD)/include/sys/stat.h
LIBFREEBSD_STAT_HDRS-y += $(LIBFREEBSD)/include/sys/statvfs.h
LIBFREEBSD_STAT_HDRS-y += $(LIBFREEBSD)/include/sys/time.h

LIBFREEBSD_STAT_SRCS-y += $(LIBFREEBSD)/src/stat/__xstat.c
LIBFREEBSD_STAT_SRCS-y += $(LIBFREEBSD)/src/stat/chmod.c
LIBFREEBSD_STAT_SRCS-y += $(LIBFREEBSD)/src/stat/fchmod.c
LIBFREEBSD_STAT_SRCS-y += $(LIBFREEBSD)/src/stat/fchmodat.c
LIBFREEBSD_STAT_SRCS-y += $(LIBFREEBSD)/src/stat/fstat.c
LIBFREEBSD_STAT_SRCS-y += $(LIBFREEBSD)/src/stat/fstatat.c
LIBFREEBSD_STAT_SRCS-y += $(LIBFREEBSD)/src/stat/futimens.c
LIBFREEBSD_STAT_SRCS-y += $(LIBFREEBSD)/src/stat/futimesat.c
LIBFREEBSD_STAT_SRCS-y += $(LIBFREEBSD)/src/stat/lchmod.c
LIBFREEBSD_STAT_SRCS-y += $(LIBFREEBSD)/src/stat/lstat.c
LIBFREEBSD_STAT_SRCS-y += $(LIBFREEBSD)/src/stat/mkdir.c
LIBFREEBSD_STAT_SRCS-y += $(LIBFREEBSD)/src/stat/mkdirat.c
LIBFREEBSD_STAT_SRCS-y += $(LIBFREEBSD)/src/stat/mkfifo.c
LIBFREEBSD_STAT_SRCS-y += $(LIBFREEBSD)/src/stat/mkfifoat.c
LIBFREEBSD_STAT_SRCS-y += $(LIBFREEBSD)/src/stat/mknod.c
LIBFREEBSD_STAT_SRCS-y += $(LIBFREEBSD)/src/stat/mknodat.c
LIBFREEBSD_STAT_SRCS-y += $(LIBFREEBSD)/src/stat/stat.c
LIBFREEBSD_STAT_SRCS-y += $(LIBFREEBSD)/src/stat/statvfs.c
LIBFREEBSD_STAT_SRCS-y += $(LIBFREEBSD)/src/stat/umask.c
LIBFREEBSD_STAT_SRCS-y += $(LIBFREEBSD)/src/stat/utimensat.c

$(eval $(call _libfreebsd_import_lib,stat,$(LIBFREEBSD_STAT_HDRS-y),$(LIBFREEBSD_STAT_SRCS-y)))
