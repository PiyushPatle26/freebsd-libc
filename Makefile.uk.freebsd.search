LIBFREEBSD_SEARCH_HDRS-y += $(LIBFREEBSD)/src/internal/libc.h
LIBFREEBSD_SEARCH_HDRS-y += $(LIBFREEBSD)/include/search.h
LIBFREEBSD_SEARCH_HDRS-y += $(LIBFREEBSD)/include/stdlib.h
LIBFREEBSD_SEARCH_HDRS-y += $(LIBFREEBSD)/include/string.h

LIBFREEBSD_SEARCH_SRCS-y += $(LIBFREEBSD)/src/search/hsearch.c
LIBFREEBSD_SEARCH_SRCS-y += $(LIBFREEBSD)/src/search/insque.c
LIBFREEBSD_SEARCH_SRCS-y += $(LIBFREEBSD)/src/search/lsearch.c
LIBFREEBSD_SEARCH_SRCS-y += $(LIBFREEBSD)/src/search/tdelete.c
LIBFREEBSD_SEARCH_SRCS-y += $(LIBFREEBSD)/src/search/tdestroy.c
LIBFREEBSD_SEARCH_SRCS-y += $(LIBFREEBSD)/src/search/tfind.c
LIBFREEBSD_SEARCH_SRCS-y += $(LIBFREEBSD)/src/search/tsearch.c
LIBFREEBSD_SEARCH_SRCS-y += $(LIBFREEBSD)/src/search/twalk.c


$(eval $(call _libfreebsd_import_lib,search,$(LIBFREEBSD_SEARCH_HDRS-y),$(LIBFREEBSD_SEARCH_SRCS-y)))
