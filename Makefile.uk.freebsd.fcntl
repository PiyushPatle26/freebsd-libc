LIBFREEBSD_FCNTL_HDRS-y += $(LIBFREEBSD)/include/errno.h
LIBFREEBSD_FCNTL_HDRS-y += $(LIBFREEBSD)/include/fcntl.h
LIBFREEBSD_FCNTL_HDRS-y += $(LIBFREEBSD)/src/internal/libc.h
LIBFREEBSD_FCNTL_HDRS-y += $(LIBFREEBSD)/include/stdarg.h
LIBFREEBSD_FCNTL_HDRS-y += $(LIBFREEBSD)/src/internal/syscall.h

LIBFREEBSD_FCNTL_SRCS-y += $(LIBFREEBSD_SRC)/lib/libc/compat-43/creat.c
LIBFREEBSD_FCNTL_SRCS-y += $(LIBFREEBSD_SRC)/lib/libc/sys/fcntl.c
LIBFREEBSD_FCNTL_SRCS-y += $(LIBFREEBSD_SRC)/lib/libc/sys/open.c
LIBFREEBSD_FCNTL_SRCS-y += $(LIBFREEBSD_SRC)/lib/libc/sys/openat.c

$(eval $(call _libfreebsd_import_lib,fcntl,$(LIBFREEBSD_FCNTL_HDRS-y),$(LIBFREEBSD_FCNTL_SRCS-y)))
