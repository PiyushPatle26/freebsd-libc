LIBFREEBSD_PRNG_HDRS-y += $(LIBFREEBSD)/include/inttypes.h
LIBFREEBSD_PRNG_HDRS-y += $(LIBFREEBSD)/src/internal/libc.h
LIBFREEBSD_PRNG_HDRS-y += $(LIBFREEBSD)/include/stdint.h
LIBFREEBSD_PRNG_HDRS-y += $(LIBFREEBSD)/include/stdlib.h
LIBFREEBSD_PRNG_HDRS-y += $(LIBFREEBSD)/include/string.h

LIBFREEBSD_PRNG_SRCS-y += $(LIBFREEBSD)/src/prng/__rand48_step.c
LIBFREEBSD_PRNG_SRCS-y += $(LIBFREEBSD)/src/prng/__seed48.c
LIBFREEBSD_PRNG_SRCS-y += $(LIBFREEBSD)/src/prng/drand48.c
LIBFREEBSD_PRNG_SRCS-y += $(LIBFREEBSD)/src/prng/lcong48.c
LIBFREEBSD_PRNG_SRCS-y += $(LIBFREEBSD)/src/prng/lrand48.c
LIBFREEBSD_PRNG_SRCS-y += $(LIBFREEBSD)/src/prng/mrand48.c
LIBFREEBSD_PRNG_SRCS-y += $(LIBFREEBSD)/src/prng/rand.c
LIBFREEBSD_PRNG_SRCS-y += $(LIBFREEBSD)/src/prng/rand_r.c
LIBFREEBSD_PRNG_SRCS-y += $(LIBFREEBSD)/src/prng/random.c
LIBFREEBSD_PRNG_SRCS-y += $(LIBFREEBSD)/src/prng/seed48.c
LIBFREEBSD_PRNG_SRCS-y += $(LIBFREEBSD)/src/prng/srand48.c

$(eval $(call _libfreebsd_import_lib,prng,$(LIBFREEBSD_PRNG_HDRS-y),$(LIBFREEBSD_PRNG_SRCS-y)))
